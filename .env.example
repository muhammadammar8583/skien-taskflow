# Existing database configuration (Prisma migration CLI and MariaDB adapter)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
DATABASE_HOST="HOST"
DATABASE_USER="USER"
DATABASE_PASSWORD="PASSWORD"
DATABASE_NAME="DATABASE"

# Authentication and password reset
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
OTP_HMAC_SECRET="replace-with-a-different-random-secret-at-least-32-characters"

# SMTP mail delivery
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="no-reply@example.com"
# Optional: defaults to true when SMTP_PORT is 465.
SMTP_SECURE="false"

# Required in production; omit both in development to use the in-memory limiter.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
